# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Cloud Storage Configuration (Optional / Runtime Configurable)
# Provide your Cloudinary credentials or configure them via the Admin Storage Manager
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend Email API Key: Used for secure 6-digit Email OTP Verification
# Provide your Resend API Key from https://resend.com
RESEND_API_KEY=""
# Optional custom sender email/domain (Default: onboarding@resend.dev)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# OneSignal Web/Mobile Push Notification App ID
# Get from OneSignal Dashboard -> Settings -> Keys & IDs
VITE_ONESIGNAL_APP_ID=""
