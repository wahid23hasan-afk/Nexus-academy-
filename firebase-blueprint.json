        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "points": { "type": "number" },
        "sequenceOrder": { "type": "number" }
      },
      "required": ["questionId", "quizId", "type", "questionText", "correctAnswer", "points", "sequenceOrder"]
    },
