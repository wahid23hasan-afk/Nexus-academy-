      "properties": {
        "lessonId": { "type": "string" },
        "courseId": { "type": "string" },
        "chapterId": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "string" },
        "sequenceOrder": { "type": "number" },
        "isPreviewAllowed": { "type": "boolean" }
      },
      "required": ["lessonId", "courseId", "chapterId", "title", "duration", "sequenceOrder", "isPreviewAllowed"]
    },
    "LessonVideo": {
      "title": "Lesson Video",
      "description": "Video player link and parameters for a lesson",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "lessonId": { "type": "string" },
        "courseId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "duration": { "type": "number" }
      },
      "required": ["videoId", "lessonId", "courseId", "videoUrl", "duration"]
    },
    "LessonResource": {
      "title": "Lesson Resource",
      "description": "Downloadable lesson files and attachments",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "lessonId": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "fileSize": { "type": "string" }
      },
      "required": ["resourceId", "lessonId", "courseId", "title", "type", "downloadUrl", "fileSize"]
    },
