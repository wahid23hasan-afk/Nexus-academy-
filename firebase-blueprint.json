{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Details of the registered academic student profile",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Legal/academic name of the student"
        },
        "username": {
          "type": "string",
          "description": "Unique academic matrix username"
        },
        "email": {
          "type": "string",
          "description": "Primary authenticated email"
        },
        "phone": {
          "type": "string",
          "description": "Optional telephone contact"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional customized portrait avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of session initiation"
        }
      },
      "required": ["fullName", "username", "email"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course offered inside the catalog",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "description": "Unique courses collection locator"
        },
        "title": {
          "type": "string",
          "description": "Full course title"
        },
        "subtitle": {
          "type": "string",
          "description": "Short subtitle overview"
        },
        "description": {
          "type": "string",
          "description": "Detailed syllabus overview"
        },
        "thumbnail": {
          "type": "string",
          "description": "Image URL for card grid preview"
        },
        "banner": {
          "type": "string",
          "description": "Widescreen spotlight banner image URL"
        },
        "instructor": {
          "type": "string",
          "description": "Full academic name of course instructor"
        },
        "instructorId": {
          "type": "string",
          "description": "Reference identifier to the instructor entity"
        },
        "category": {
          "type": "string",
          "description": "Niche field categorization (e.g. Web Development)"
        },
        "price": {
          "type": "number",
          "description": "Base course original pricing"
        },
        "discountPrice": {
          "type": "number",
          "description": "Optional active campaign promotional price"
        },
        "rating": {
          "type": "number",
          "description": "Verified student feedback average rating score"
        },
        "reviewCount": {
          "type": "number",
          "description": "Total reviews submitted"
        },
        "students": {
          "type": "number",
          "description": "Total academic enrollments count"
        },
        "language": {
          "type": "string",
          "description": "Teaching linguistic medium (e.g. Bangla)"
        },
        "duration": {
          "type": "string",
          "description": "Syllabus scope duration (e.g. 60 hours)"
        },
        "level": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced", "All Levels"],
          "description": "Student prerequisites level"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Toggles catalog primary featuring"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Toggles bestseller badges"
        },
        "isNew": {
          "type": "boolean",
          "description": "Toggles newest badge highlighting"
        },
        "learningOutcomes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skillsGained": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastUpdated": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["courseId", "title", "instructor", "category", "price", "rating", "students", "language", "duration", "level"]
    },
    "Banner": {
      "title": "Banner Slide",
      "description": "Spotlight campaign billboard auto sliding slides",
      "type": "object",
      "properties": {
        "bannerId": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        }
      },
      "required": ["bannerId", "imageUrl", "title", "subtitle"]
    },
    "Instructor": {
      "title": "Instructor",
      "description": "Verified academic profile representing a faculty tutor",
      "type": "object",
      "properties": {
        "instructorId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "experience": {
          "type": "string"
        },
        "totalStudents": {
          "type": "number"
        },
        "totalCourses": {
          "type": "number"
        },
        "averageRating": {
          "type": "number"
        },
        "isVerified": {
          "type": "boolean"
        }
      },
      "required": ["instructorId", "name", "photoURL", "bio", "isVerified"]
    },
    "CurriculumChapter": {
      "title": "Curriculum Chapter",
      "description": "Chapter breakdown including individual video/text lessons",
      "type": "object",
      "properties": {
        "chapterId": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sequenceOrder": {
          "type": "number"
        },
        "lessonsCount": {
          "type": "number"
        },
        "totalDuration": {
          "type": "string"
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lessonId": { "type": "string" },
              "title": { "type": "string" },
              "duration": { "type": "string" },
              "isPreviewAllowed": { "type": "boolean" },
              "sequenceOrder": { "type": "number" }
            }
          }
        }
      },
      "required": ["chapterId", "courseId", "title", "sequenceOrder", "lessons"]
    },
    "CourseReview": {
      "title": "Course Review",
      "description": "Feedback reviews logged by students for courses",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "studentName": {
          "type": "string"
        },
        "studentPhotoURL": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["reviewId", "courseId", "studentName", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code data",
      "type": "object",
      "properties": {
        "couponId": { "type": "string" },
        "code": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "isActive": { "type": "boolean" },
        "expiryDate": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["couponId", "code", "discountType", "discountValue", "isActive"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Special active promotional campaign offer",
      "type": "object",
      "properties": {
        "offerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discountPercent": { "type": "number" },
        "badgeText": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["offerId", "title", "discountPercent", "isActive"]
    },
    "CourseBenefit": {
      "title": "Course Benefit",
      "description": "Premium benefits showing what students will get",
      "type": "object",
      "properties": {
        "benefitId": { "type": "string" },
        "title": { "type": "string" },
        "iconName": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["benefitId", "title", "iconName", "description"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Stores user purchases of courses",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "amount": { "type": "number" },
        "discount": { "type": "number" },
        "coupon": { "type": "string" },
        "status": { "type": "string" },
        "transactionId": { "type": "string" },
        "purchaseDate": { "type": "string" }
      },
      "required": ["purchaseId", "userId", "courseId", "paymentMethod", "amount", "status", "transactionId", "purchaseDate"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Stores payment gateway session details",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["paymentId", "userId", "courseId", "amount", "paymentMethod", "transactionId", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction ledger entry",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "purchaseId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["transactionId", "purchaseId", "amount", "paymentMethod", "status", "timestamp"]
    },
    "CourseLesson": {
      "title": "Course Lesson",
      "description": "Information about a specific lesson in a course",
