        "bookmarkId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "lessonId": { "type": "string" },
        "timestamp": { "type": "number" },
        "label": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["bookmarkId", "userId", "courseId", "lessonId", "timestamp", "label", "createdAt"]
    },
    "WatchHistory": {
      "title": "Watch History",
