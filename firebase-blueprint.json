        "noteId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "lessonId": { "type": "string" },
        "timestamp": { "type": "number" },
        "noteTitle": { "type": "string" },
        "noteContent": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["noteId", "userId", "courseId", "lessonId", "timestamp", "noteTitle", "noteContent", "createdAt"]
    },
    "LessonBookmark": {
      "title": "Lesson Bookmark",
      "description": "Bookmarked timeline position for a lesson",
