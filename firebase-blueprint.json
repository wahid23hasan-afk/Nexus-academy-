        "fileSize": { "type": "string" }
      },
      "required": ["downloadId", "resourceId", "resourceTitle", "resourceType", "status", "progress", "downloadSpeed", "remainingTime", "fileSize"]
    },
    "OfflineResource": {
      "title": "Offline Resource",
      "description": "Files physically persisted in local cache storage",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "fileSize": { "type": "string" },
